# Copy to .env if you switch docker-compose.yml to env_file-based secrets (production).
# Never commit .env — it is gitignored at repo root.
#
# POSTGRES_USER=engram
# POSTGRES_PASSWORD=replace-me
# POSTGRES_DB=engram_cloud
# ENGRAM_DATABASE_URL=postgres://engram:replace-me@postgres:5432/engram_cloud?sslmode=disable
# ENGRAM_CLOUD_TOKEN=replace-with-long-random-bearer-token
# ENGRAM_CLOUD_ADMIN=replace-with-separate-admin-token
# ENGRAM_JWT_SECRET=replace-with-32-plus-byte-random-secret
# ENGRAM_CLOUD_ALLOWED_PROJECTS=training-records
# ENGRAM_CLOUD_HOST=0.0.0.0
# ENGRAM_PORT=18080
# Do NOT set ENGRAM_CLOUD_INSECURE_NO_AUTH in production.
